# Supabase PostgreSQL Connection
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# The Movie Database (TMDB) API v3 Key
TMDB_API_KEY="your_tmdb_api_key_here"

# Secret API Key for protected scraper/admin endpoints (x-api-key header)
ADMIN_API_KEY="your_secure_admin_api_key"

# Keep HTTP-triggered scraping disabled in API containers; run scrapers via CLI worker
ENABLE_HTTP_SCRAPER="false"

# Set to "true" when daily scraping is delegated to GitHub Actions
DISABLE_INTERNAL_CRON="true"

# Optional: override Cinépolis public GraphQL storefront key if rotated upstream
# CINEPOLIS_PUBLIC_API_KEY="lQM6Mkvri1iHksKKCfpAiwGXq0YUZA7Nn6XAXRPr4i13LwXo"

# Comma-separated list of allowed CORS origins
FRONTEND_URL="https://cinema-agenda-app.vercel.app,http://localhost:3000"
PORT=3000
