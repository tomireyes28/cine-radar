# PostgreSQL Connection (Local Docker quickstart on port 5434)
DATABASE_URL="postgresql://postgres:supersecretpassword@localhost:5434/cinema_db?schema=public"
# Production example (Supabase Transaction Pooler on port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# HTTP Server Port (3001 avoids collision with Next.js dev server on 3000)
PORT=3001

# Comma-separated list of exact allowed CORS origins
FRONTEND_URL="http://localhost:3000,https://cinema-agenda-app.vercel.app"

# The Movie Database (TMDB) API v3 Key
TMDB_API_KEY="your_tmdb_api_key_here"

# Secret API Key for protected administrative scraper endpoints (x-api-key header)
ADMIN_API_KEY="your_secure_admin_api_key"

# Keep HTTP-triggered scraping disabled in API containers; run scrapers via CLI worker
ENABLE_HTTP_SCRAPER="false"

# Set to "true" when daily scraping is delegated to GitHub Actions
DISABLE_INTERNAL_CRON="true"

# Express reverse-proxy hop count for @nestjs/throttler client IP resolution
# Defaults to 1 in NODE_ENV=production and false in local development
# TRUST_PROXY=1

# Optional: override Cinépolis public GraphQL storefront key if rotated upstream
# CINEPOLIS_PUBLIC_API_KEY=""
