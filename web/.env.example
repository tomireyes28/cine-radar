# PRIVATE: dedicated read-only PostgreSQL role via Supabase transaction pooler.
# Provision using api/scripts/setup-web-reader.cjs; never use the owner URL here.
# Configure the same private variable in the Next.js hosting environment.
SUPABASE_DATABASE_URL="postgresql://cine_radar_web.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres"
# Public root CA PEM, downloaded from Supabase; required for strict TLS validation.
# Setup fills this automatically from web/certs/supabase-ca.crt.
SUPABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# PRIVATE: TMDB v3 key for the server-rendered upcoming page.
TMDB_API_KEY="your_tmdb_api_key_here"

# Canonical public URL used for OpenGraph / SEO metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
